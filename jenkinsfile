

pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hema84683/facebook-ui'
        IMAGE_TAG  = 'latest'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Login to DockerHub & Push Image') {
            steps {
                script {
                    docker.withRegistry('', 'dockerhub credentials') {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push('latest')
                    }
                }
            }
        }

        stage('Deploy Container') {
            steps {
                sh """
                    docker stop facebook-container || true
                    docker rm facebook-container || true
                    docker run -d --name facebook-container -p 8080:80 ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        always {
            cleanWs()
            echo "✅ Pipeline finished"
        }
        failure {
            echo "❌ Build failed. Please check the logs."
        }
    }
}
